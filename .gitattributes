# 默认按文本处理并统一换行符为 LF，避免 Windows 与 CI 之间产生虚假 diff
* text=auto eol=lf

*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
Makefile text eol=lf

# Windows 脚本保持 CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制资源不做换行符转换
*.png    binary
*.jpg    binary
*.ico    binary
*.exe    binary
*.zip    binary
*.syso   binary
